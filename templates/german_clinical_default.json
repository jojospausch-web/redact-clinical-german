  "structured_patterns": {
    "patient_block": {
      "pattern": "^(Herr|Frau)\\s+([A-ZÄÖÜ][a-zäöüß-]+),\\s+([A-ZÄÖÜ][a-zäöüß-]+),\\s+\\*(\\d{2}\\.\\d{2}\\.\\d{4})",
      "comment": "^ = only at line beginning (requires re.MULTILINE flag), prevents 'Sehr geehrter Herr Kollege'",
      "groups": {
        "1": "SALUTATION",
        "2": "LASTNAME",
        "3": "FIRSTNAME",
        "4": "BIRTHDATE"
      }
    },
    "case_id": {
      "pattern": "(?:Pat\\.?-?(?:Nr\\.?|Nummer)|Fall-?(?:Nr\\.?|Nummer)):?\\s*([0-9]{6,10})",
      "type": "CASE_ID",
      "comment": "Matches Pat.-Nr., Pat-Nummer, Fall-Nr., Fall-Nummer, Fallnummer with all variations"
    },
    "address": {
      "pattern": "([A-ZÄÖÜ][a-zäöüß]+(?:straße|str\\.|weg|platz|allee))\\s+(\\d+[a-z]?),?\\s+(\\d{5})\\s+([A-ZÄÖÜ][a-zäöüß]+)",
      "type": "ADDRESS"
    },
    "doctor_name": {
      "pattern": "((?:PD\\s+Dr\\.|Prof\\.\\s+Dr\\.|Dr\\.|Prof\\.|PD)\\s+(?:med\\.\\s+)?(?:(?-i:[A-ZÄÖÜ])[a-zäöüß-]+\\s+){0,2}(?-i:[A-ZÄÖÜ])[a-zäöüß-]+)",
      "type": "DOCTOR_NAME",
      "comment": "Non-greedy: handles combined titles (PD Dr., Prof. Dr.), max 3 name parts; (?-i:[A-ZÄÖÜ]) is intentionally repeated for each name-part position to force uppercase-only matching in those sub-patterns even under the outer IGNORECASE flag, preventing lowercase verbs/adjectives from being consumed as additional name tokens."
    },
    "doctor_with_location": {
      "pattern": "Dr\\.\\s+([A-ZÄÖÜ][a-zäöüß-]+)(?:,\\s+([A-Z]{2,})\\s+([A-ZÄÖÜ][a-zäöüß]+))?",
      "comment": "Captures 'Dr. Führig, MVZ Hannover'",
      "groups": {
        "1": "DOCTOR_NAME",
        "2": "ORGANIZATION",
        "3": "CITY"
      }
    },
    "doctor_name_parentheses": {
      "pattern": "\\(((Prof\\.|Dr\\.|PD)(?:[^\\)]+))\\)",
      "type": "DOCTOR_NAME",
      "comment": "Matches doctor names enclosed in parentheses: (PD Dr. Christoph Jensen)"
    },
    "salutation_with_name": {
      "pattern": "(?:Herr|Frau)\\s+(?!(?:Kollege|Kollegin)\\b)([A-ZÄÖÜ][a-zäöüß-]{2,})",
      "type": "PERSON_NAME",
      "comment": "Matches 'Herr Jensen', 'Frau Meier' (excludes 'Herr Kollege' / 'Frau Kollegin')"
    },
    "doctor_signature": {
      "context_trigger": "Mit freundlichen Grüßen",
      "pattern": "(Prof\\.|Dr\\.|PD)\\s+(med\\.\\s+)?([A-ZÄÖÜ][a-zäöüß-]+(?:\\s+[A-ZÄÖÜ][a-zäöüß-]+)+)",
      "type": "DOCTOR_NAME",
      "lookahead": 200
    },
    "referring_doctor": {
      "context_trigger": "Zuweiser",
      "pattern": "Dr\\.\\s+([A-ZÄÖÜ][a-zäöüß-]+)",
      "type": "REFERRING_DOCTOR"
    },
    "postal_code_with_city": {
      "pattern": "(?<![/\\d])(\\d{5})\\s+([A-ZÄÖÜ][a-zäöüß]+)",
      "comment": "Negative lookbehind (?<![/\\d]) prevents matching 5-digit sequences that appear inside phone numbers (e.g., 0561/93769 Kassel) or other digit sequences.",
      "groups": {
        "1": "POSTAL_CODE",
        "2": "CITY"
      }
    },
    "postal_code_standalone": {
      "pattern": "(?<![/\\d])(?:PLZ:?\\s*)?(\\d{5})(?!\\d)",
      "type": "POSTAL_CODE",
      "comment": "Negative lookbehind (?<![/\\d]) prevents matching inside phone numbers or larger digit sequences."
    },
    "city_facility_simple": {
      "pattern": "\\b([A-ZÄÖÜ][a-zäöüß]+er)\\s+(Klinikum|Krankenhaus|Klinik|MVZ|Herzzentrum|Tumorzentrum|Lungenzentrum)\\b",
      "comment": "Stadt-Adjektiv + einfache Einrichtung: 'Einbecker Krankenhaus'",
      "groups": {
        "1": "CITY_ADJECTIVE",
        "2": "FACILITY_TYPE"
      }
    },
    "university_hospital": {
      "pattern": "\\b(Universitätsklinikum|Uniklinikum|UKE)\\s+([A-ZÄÖÜ][a-zäöüß-]+(?:\\s+[A-ZÄÖÜ][a-zäöüß-]+)?)",
      "comment": "Universitätsklinikum + Stadt: 'Universitätsklinikum Göttingen'",
      "groups": {
        "1": "FACILITY_TYPE",
        "2": "CITY"
      }
    },
    "medical_facility_with_city": {
      "pattern": "\\b([A-ZÄÖÜ][a-zäöüß]+er)\\s+((?:[A-ZÄÖÜ][a-zäöüß-]*\\s+){0,3}[A-ZÄÖÜ]?[a-zäöüß-]*(?:Klinikum|Klinik|Krankenhaus|Hospital|Zentrum|MVZ)\\b(?:\\s+(?-i:[A-ZÄÖÜ])[a-zäöüß-]+)?)",
      "comment": "City-adjective + facility: max 5 words total, explicit facility keywords required (Klinikum, Klinik, Krankenhaus, Hospital, Zentrum, MVZ). Replaces unbounded [^.]{0,60} to prevent over-matching. (?-i:[A-ZÄÖÜ]) prevents lowercase words being matched as optional trailing city name.",
      "groups": {
        "1": "CITY_ADJECTIVE",
        "2": "FACILITY_FULL_NAME"
      },
      "type": "MEDICAL_FACILITY"
    },
    "phone_landline": {
      "pattern": "(?:(?:Tel\\.?:|Telefon:|Nummer:)\\s+|(?:(?:\\+49|0)\\s?)(?:\\(0\\))?\\s*)\\d{2,5}[\\s\\-\\/]\\d{3,9}(?:[\\s\\-]\\d{2,4})?\\b",
      "type": "PHONE",
      "comment": "Festnetz: requires EITHER explicit prefix (Tel:, Telefon:, Nummer:) OR international/national prefix (+49, 0). Trailing \\b prevents partial matches inside longer digit sequences."
    },
    "phone_mobile": {
      "pattern": "(?:Mobil:|Handy:)?\\s*(?:\\+49\\s?)?(0?1[5-7][0-9])[\\s\\-\\/]?(\\d{7,8})",
      "type": "PHONE_MOBILE",
      "comment": "Mobil: 0173/1234567, +49 173 12345678"
    },
    "phone_context": {
      "pattern": "(?:unter\\s+(?:der\\s+)?Nummer|erreichbar\\s+unter|Rufnummer):?\\s*(0\\d{3,4}[\\s\\-\\/]\\d{5,8})",
      "type": "PHONE",
      "comment": "Context-based phone numbers: 'unter der Nummer 0561/937690'"
    },
    "email": {
      "pattern": "\\b([a-zA-Z0-9][a-zA-Z0-9._%+-]{0,63}@[a-zA-Z0-9][a-zA-Z0-9.-]{0,253}\\.[a-zA-Z]{2,})",
      "type": "EMAIL",
      "comment": "E-Mail: max@klinikum.de"
    },
    "fax": {
      "pattern": "(?:Fax:|Telefax:|Fax-Nr\\.?:?)\\s+(?:\\+49\\s?)?(?:\\(0\\))?\\s*\\d{2,5}[\\s\\-\\/]\\d{3,9}\\b",
      "type": "FAX",
      "comment": "Fax: MUST have explicit prefix (Fax:, Telefax:, Fax-Nr.:) followed by whitespace. Trailing \\b prevents partial digit matches."
    },
    "hk_number": {
      "pattern": "HK-?Nr\\.?:?\\s*([0-9]{4}\\/[0-9]{2})",
      "type": "HK_NUMBER",
      "comment": "Format: HK-Nr.: 1234/56"
    },
    "pacemaker_id": {
      "pattern": "\\b(?:DR|VR|PM|SM|ICD|CRT)\\s+\\d{6}\\b",
      "type": "DEVICE_ID",
      "comment": "Pacemaker/ICD serial numbers: DR 268880, VR 123456, ICD 987654, CRT 456789"
    },
    "medical_facility": {
      "pattern": "(?:Ambulante[sn]?\\s+)?(Herzzentrum|Tumorzentrum|Lungenzentrum|Ambulanzzentrum|Rehabilitationszentrum|Reha-?Zentrum|Rehaklinik|Klinik(?: und Rehabilitationszentrum)?)\\s+((?:Bad\\s+)?(?!(?:f[üu]r|und|oder|am|an|im|in|ob|zu|bei|vom|von|der|des|die|das)\\b)[A-ZÄÖÜ][a-zäöüß]{2,}(?:\\s+(?:am|an|der|im|in|ob)\\s+[A-ZÄÖÜ][a-zäöüß]+)?)",
      "groups": {
        "1": "FACILITY_TYPE",
        "2": "CITY"
      },
      "comment": "Medical facility + city: requires city token ≥3 letters (uppercase + 2+ lowercase via {2,}) and excludes short prepositions/articles (für, und, am, an, im, in, ob, zu, bei, vom, von, der, des, die, das) from being matched as the city name. Note: the inner (?:am|an|der|im|in|ob) allows compound city names like 'Frankfurt am Main' and serves a different purpose than the leading negative lookahead exclusion list."
    }
  },
  
  "location_anonymization": {
    "enabled": true,
    "city_database": "data/cities_de.txt",
    "facilities_database": "data/medical_facilities_de.json",
    
    "context_triggers": {
      "prepositions": ["in", "aus", "nach", "von", "bei"],
      "facility_keywords": [
        "Universitätsklinikum", "Uniklinik", "Klinikum", "Krankenhaus",
        "Herzzentrum", "Tumorzentrum", "Lungenzentrum", "MVZ", "Charité",
        "Medizinisches Versorgungszentrum",
        "Ambulanzzentrum", "Rehabilitationszentrum", "Reha-Zentrum", "Rehaklinik"
      ],
      "referral_keywords": ["überwiesen", "Zuweiser", "eingewiesen", "verlegt"]
    },
    
    "location_blacklist": [
      "UKE",
      "Charité",
      "Northeim",
      "Eppendorf"
    ],
    
    "replacement": "[ORT]",
    "facility_replacement": "[KLINIK]"
  },
  
  "date_handling": {
    "birthdate": {
      "pattern": "\\*(\\d{2}\\.\\d{2}\\.\\d{4})",
      "action": "remove"
    }
  },
  
  "pii_mechanisms": {
    "PATIENT_NAME": "redact",
